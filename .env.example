# ===============================
# DATABASE (PostgreSQL)
# ===============================
# Format: postgresql://username:password@host:port/database
# 
# Local Docker: postgresql://postgres:password@postgres:5432/decluttered_db
# Remote (Render.com): postgresql://user:password@dpg-xxxx.region-postgres.render.com/database_name
# Remote (AWS RDS): postgresql://user:password@decluttered.xxxxx.us-east-1.rds.amazonaws.com:5432/decluttered_db
#
DB_URI="postgresql://postgres:password@postgres:5432/decluttered_db"

# ===============================
# CACHE (Redis)
# ===============================
# Local Redis: redis://localhost:6379
# Docker Redis: redis://redis:6379
# Upstash Cloud (TLS): rediss://default:password@host.upstash.io:port
# AWS ElastiCache: redis://endpoint.cache.amazonaws.com:6379
#
REDIS_URL="redis://redis:6379"

# ===============================
# MESSAGE QUEUE (Apache Kafka)
# ===============================
# Local/Docker: kafka:29092 (internal) or localhost:9092 (external)
# Confluent Cloud: pkc-xxxxxx.region.provider.confluent.cloud:9092
#
KAFKA_BROKER="kafka:29092"
KAFKA_TOPIC="raw-articles"

# Optional: Kafka SASL Authentication (leave empty for local Docker Kafka)
KAFKA_USER=""
KAFKA_PASSWORD=""

# ===============================
# VECTOR DATABASE (Qdrant)
# ===============================
# Local Docker: 127.0.0.1 or qdrant (docker hostname)
# Qdrant Cloud: https://your-cluster-id.qdrant.io
#
QDRANT_HOST="qdrant"
QDRANT_PORT="6333"

# Optional: API key for Qdrant Cloud (leave empty for local Docker)
QDRANT_API_KEY=""

QDRANT_COLLECTION="news_articles"

# Vector similarity threshold for clustering (0.0 to 1.0)
# Higher = stricter clustering (less articles grouped together)
# Lower = looser clustering (more articles grouped together)
# Default: 0.82 (recommended)
SIMILARITY_THRESHOLD="0.82"

# ===============================
# AI & LLM SERVICES
# ===============================
# Groq API Key for LLM-powered summarization
# Get free API key at: https://console.groq.com
# Sign up → API Keys → Create New API Key
#
GROQ_API_KEY="gsk_your_groq_api_key_here"

# ===============================
# NEWS SOURCES
# ===============================
# Optional: Custom RSS feed URL (defaults to TechCrunch if not set)
# Examples:
#   https://techcrunch.com/feed/
#   https://www.bbc.com/news/?format=xml
#   https://feeds.bloomberg.com/markets/news.rss
#
RSS_FEED_URL="https://techcrunch.com/feed/"

# ===============================
# FRONTEND (Next.js)
# ===============================
# Public API URL (accessible from browser)
# Local: http://localhost:8080
# Production: https://api.yourdomain.com
#
NEXT_PUBLIC_API_URL="http://localhost:8080"
